# Copy this file to .env (never commit .env)
# Password for all demo accounts. If empty, random passwords are generated and printed once at first start.
DEMO_PASSWORD=
# 0 only for local development over http. Keep 1 online (HTTPS).
COOKIE_SECURE=0
PORT=8000
SESSION_TTL_SECONDS=7200
# DATA_FILE=data/db.json
# TRUST_PROXY=1   # set on Cloud Run
